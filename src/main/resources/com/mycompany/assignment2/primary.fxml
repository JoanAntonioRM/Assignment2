<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.assignment2.CarRaceController">
   <children>
      <Label text="Welcome to the Car Race!">
         <font>
            <Font name="System Bold" size="34.0" />
         </font></Label>
      <Label text="Meet our 4 racers - the race starts right after the slideshow.">
         <font>
            <Font size="15.0" />
         </font></Label>
      <ImageView fx:id="slideImage" fitWidth="520.0" pickOnBounds="true" preserveRatio="true" />
      <Label fx:id="captionLabel">
         <font>
            <Font name="System Bold" size="22.0" />
         </font></Label>
      <Button fx:id="skipButton" mnemonicParsing="false" onAction="#onSkip" prefHeight="25.0" prefWidth="70.0" text="Skip" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
